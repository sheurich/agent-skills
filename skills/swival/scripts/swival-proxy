#!/usr/bin/env bash
# Start/stop the litellm proxy for Swival
# Usage: swival-proxy start|stop|status|restart

set -euo pipefail

CONFIG_DIR="${HOME}/.config/litellm"
CONFIG="${CONFIG_DIR}/config.yaml"
PORT=4000
PIDFILE="${CONFIG_DIR}/proxy.pid"
LOGFILE="${CONFIG_DIR}/proxy.log"

_pid_is_proxy() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null || return 1
  ps -p "$pid" -o args= 2>/dev/null | grep -q "litellm.*--config" 2>/dev/null
}

require_prereqs() {
  if ! command -v litellm >/dev/null 2>&1; then
    echo "Error: litellm is not installed or not in PATH." >&2
    echo "Install with: uv tool install 'litellm[proxy,bedrock]'" >&2
    echo "Or: pip install 'litellm[proxy]'" >&2
    return 1
  fi

  mkdir -p "$CONFIG_DIR"

  if [[ ! -f "$CONFIG" ]]; then
    echo "Error: config file not found at $CONFIG" >&2
    return 1
  fi
}

start() {
  require_prereqs
  if [[ -f "$PIDFILE" ]] && _pid_is_proxy "$(cat "$PIDFILE")"; then
    echo "litellm proxy already running (PID $(cat "$PIDFILE"))"
    return 0
  fi
  rm -f "$PIDFILE"
  echo "Starting litellm proxy on port ${PORT}..."
  nohup litellm --config "$CONFIG" --port "$PORT" > "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 2
  if _pid_is_proxy "$(cat "$PIDFILE")"; then
    echo "litellm proxy started (PID $(cat "$PIDFILE"))"
  else
    echo "Failed to start. Check $LOGFILE" >&2
    rm -f "$PIDFILE"
    return 1
  fi
}

stop() {
  if [[ -f "$PIDFILE" ]]; then
    local pid
    pid=$(cat "$PIDFILE")
    if _pid_is_proxy "$pid"; then
      kill "$pid"
      echo "litellm proxy stopped (PID $pid)"
    else
      echo "litellm proxy not running (stale PID file)"
    fi
    rm -f "$PIDFILE"
  else
    echo "litellm proxy not running"
  fi
}

status() {
  if [[ -f "$PIDFILE" ]] && _pid_is_proxy "$(cat "$PIDFILE")"; then
    echo "litellm proxy running (PID $(cat "$PIDFILE"), port ${PORT})"
  else
    echo "litellm proxy not running"
    return 1
  fi
}

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  *)       echo "Usage: swival-proxy start|stop|status|restart" >&2; exit 1 ;;
esac
